# Copy to .env (or .env.live for the live phase) and fill in. Never commit either. Scripts never print these.
#
# Phase A runs everything locally: `npm run dev:server` starts a parse-server with FIXED local keys
# (scripts/lib/env.mjs LOCAL — not secrets, the server only listens on localhost and the database is a
# throwaway), REST at http://localhost:1353/parse and GraphQL at http://localhost:1353/graphql. An empty .env
# is fine for local work. These variables are only read when the scripts are later pointed at a Back4app
# backend with --live (the live phase — the COORDINATOR runs it after Phase 0; nothing in Phase A may call a
# remote backend).
#
# Back4app → your backend app → App Settings → Security & Keys.
# MASTER_KEY is OPTIONAL even then: everything privileged goes through the setup-gated Cloud functions
# (setupSchema, seedData, testInspect, testCleanup), which additionally require SETUP_TOKEN below.
APP_ID=
JS_KEY=
REST_KEY=
MASTER_KEY=
SERVER_URL=https://parseapi.back4app.com

# GraphQL endpoint of the live backend. Coordinator probe 2026-11-03: POST
# https://parseapi.back4app.com/graphql answered introspection on a Free-plan backend (see build diary).
# Phase 0 still owns the full verification (headers, session parity, schema coverage).
# GRAPHQL_URL=https://parseapi.back4app.com/graphql

# The administrative setup token: the raw token the operator generated (`openssl rand -hex 24`). Its SHA-256
# hex must be configured server-side (cloud/config.js reads SETUP_TOKEN_SHA256 from the Cloud Code
# environment, or edit the fallback before upload). Without BOTH the SETUP_ENABLED flag and the matching
# token, setupSchema/seedData/testInspect/testCleanup refuse. The default deployment ships with both unset.
# SETUP_TOKEN=

# Local development only: Postgres database used by the local parse-server (port 5433, brew postgresql@17 —
# the same instance tenant-lab and chat-lab use; this repo's databases are gql_dev / gql_test).
DATABASE_URL=postgres://localhost:5433/gql_dev
